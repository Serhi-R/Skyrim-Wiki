@using SkyrimWIKI.Services
@model IEnumerable<SkyrimWIKI.Models.ViewModels.LocationCardViewModel>
@{
    ViewData["Title"] = L["locations.title"];
}

<h1 class="page-title text-2xl">@L["locations.title"]</h1>
<p class="mt-2 text-sm text-ice">@L["locations.subtitle"]</p>
<hr class="divider-gold mt-3 w-full" />

<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var card in Model)
    {
        var image = Images.Hold(card.Location.Name);
        var text = L.Content("locations", card.Location.Name, card.Location.Description);
        <a asp-action="Details" asp-route-id="@card.Location.Id"
           class="frame frame-hover group block overflow-hidden">
            <div class="relative h-40 border-b border-slate bg-gradient-to-br from-slate/50 to-panel">
                @if (image is not null)
                {
                    <img src="@image" alt="@card.Location.Name" width="800" height="533"
                         loading="lazy" class="cover opacity-80 transition group-hover:opacity-100" />
                }
            </div>
            <div class="p-5">
                <div class="flex items-start justify-between gap-2">
                    <h2 class="break-words font-display font-semibold text-ivory">@card.Location.Name</h2>
                    <span class="badge shrink-0">@string.Format(L["locations.questCount"], card.QuestCount)</span>
                </div>
                <p class="meta mt-1">@card.Location.Region</p>
                <p class="mt-2 text-sm leading-relaxed text-frost/80">
                    @(text.Length > 120 ? text[..120] + "..." : text)
                </p>
            </div>
        </a>
    }
</div>
