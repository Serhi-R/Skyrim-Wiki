@model SkyrimWIKI.Models.ViewModels.LocationDetailsViewModel
@{
    ViewData["Title"] = Model.Location.Name;
}

<a asp-action="Index" class="text-sm font-medium text-emerald-700 hover:underline">
    &larr; <span class="t-en">All locations</span><span class="t-bg">Всички локации</span>
</a>

<header class="mt-3 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-wide text-emerald-700">@Model.Location.Region</p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900">@Model.Location.Name</h1>
    <p class="mt-3 whitespace-pre-line leading-relaxed text-slate-700">@Model.Location.Description</p>
</header>

<section class="mt-8">
    <h2 class="text-xl font-bold text-slate-900">
        <span class="t-en">Quests here</span><span class="t-bg">Задания тук</span>
    </h2>

    @if (Model.Quests.Count == 0)
    {
        <p class="mt-3 rounded-xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500">
            <span class="t-en">No quests in this location yet.</span>
            <span class="t-bg">Още няма задания в тази локация.</span>
        </p>
    }
    else
    {
        <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var quest in Model.Quests)
            {
                <partial name="_QuestCard" model="quest" />
            }
        </div>
    }
</section>
