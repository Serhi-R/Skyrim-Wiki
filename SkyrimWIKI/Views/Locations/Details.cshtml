@using SkyrimWIKI.Services
@model SkyrimWIKI.Models.ViewModels.LocationDetailsViewModel
@{
    ViewData["Title"] = Model.Location.Name;
    var banner = Images.Hold(Model.Location.Name, large: true);
}

<a asp-action="Index" class="link text-sm font-semibold">&larr; @L["locations.title"]</a>

<header class="frame mt-3 overflow-hidden">
    @if (banner is not null)
    {
        <div class="relative h-56 border-b border-slate sm:h-72">
            <img src="@banner" alt="@Model.Location.Name" width="1600" height="1067" class="cover" />
            <div class="absolute inset-0"
                 style="background: linear-gradient(180deg, rgba(15,19,24,0.15) 0%, rgba(15,19,24,0.9) 100%);"></div>
        </div>
    }
    <div class="p-6">
        <p class="meta text-gold">@Model.Location.Region</p>
        <h1 class="page-title mt-1 text-2xl">@Model.Location.Name</h1>
        <hr class="divider-gold mt-4 w-full" />
        <p class="mt-4 whitespace-pre-line leading-relaxed text-frost/90">@L.Content("locations", Model.Location.Name, Model.Location.Description)</p>
    </div>
</header>

<section class="mt-8">
    <h2 class="section-title text-lg">@L["locations.questsHere"]</h2>
    <hr class="divider-gold mt-3 w-full" />

    @if (Model.Quests.Count == 0)
    {
        <p class="empty mt-4">@L["locations.noQuests"]</p>
    }
    else
    {
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var quest in Model.Quests)
            {
                <partial name="_QuestCard" model="quest" />
            }
        </div>
    }
</section>
