@model IEnumerable<SkyrimWIKI.Models.Race>
@{
    ViewData["Title"] = L["races.title"];
}

<h1 class="page-title text-2xl">@L["races.title"]</h1>
<p class="mt-2 text-sm text-ice">@L["races.subtitle"]</p>
<hr class="divider-gold mt-3 w-full" />

<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var race in Model)
    {
        var image = Images.Race(race.Name);
        var text = L.Content("races", race.Name, race.Description);
        <a asp-action="Details" asp-route-id="@race.Id" class="frame frame-hover group block overflow-hidden">
            <div class="relative h-40 border-b border-slate bg-gradient-to-br from-slate/50 to-panel">
                @if (image is not null)
                {
                    <img src="@image" alt="@race.Name" width="800" height="533"
                         loading="lazy" class="cover opacity-90 transition group-hover:opacity-100" />
                }
            </div>
            <div class="p-5">
                <div class="flex items-start justify-between gap-2">
                    <h2 class="break-words font-display font-semibold text-ivory">@race.Name</h2>
                    @if (!race.Playable)
                    {
                        <span class="badge badge-muted shrink-0">NPC</span>
                    }
                </div>
                <p class="mt-2 text-sm leading-relaxed text-frost/80">
                    @(text.Length > 120 ? text[..120] + "..." : text)
                </p>
            </div>
        </a>
    }
</div>
