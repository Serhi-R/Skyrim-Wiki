@model SkyrimWIKI.Models.Race
@{
    ViewData["Title"] = Model.Name;
    var banner = Images.Race(Model.Name, large: true);
}

<article class="mx-auto max-w-2xl">
    <a asp-action="Index" class="link text-sm font-semibold">&larr; @L["races.title"]</a>

    <div class="frame mt-3 overflow-hidden">
        @if (banner is not null)
        {
            <div class="relative h-56 border-b border-slate sm:h-72">
                <img src="@banner" alt="@Model.Name" width="1600" height="1067" class="cover" />
                <div class="absolute inset-0"
                     style="background: linear-gradient(180deg, rgba(15,19,24,0.1) 0%, rgba(15,19,24,0.9) 100%);"></div>
            </div>
        }
        <div class="p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h1 class="page-title text-2xl">@Model.Name</h1>
                <span class="badge">@(Model.Playable ? L["races.playable"] : L["races.notPlayable"])</span>
            </div>
            <hr class="divider-gold mt-4 w-full" />
            <p class="mt-4 whitespace-pre-line leading-relaxed text-frost/90">@L.Content("races", Model.Name, Model.Description)</p>
        </div>
    </div>
</article>
