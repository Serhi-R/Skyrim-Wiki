@model SkyrimWIKI.Models.Race
@{
    ViewData["Title"] = Model.Name;
}

<article class="mx-auto max-w-2xl">
    <a asp-action="Index" class="text-sm font-medium text-emerald-700 hover:underline">
        &larr; <span class="t-en">All races</span><span class="t-bg">Всички раси</span>
    </a>

    <div class="mt-3 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="text-2xl font-bold text-slate-900">@Model.Name</h1>
            <span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700">
                @(Model.Playable
                    ? "Playable / Играема"
                    : "Not playable / Неиграема")
            </span>
        </div>
        <p class="mt-4 whitespace-pre-line leading-relaxed text-slate-700">@Model.Description</p>
    </div>
</article>
