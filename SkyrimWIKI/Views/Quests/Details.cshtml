@model SkyrimWIKI.Models.ViewModels.QuestDetailsViewModel
@{
    ViewData["Title"] = Model.Quest.Title;
}

<article class="mx-auto max-w-3xl">
    <a asp-action="Index" class="link font-display text-xs font-semibold uppercase tracking-[0.14em]">
        &larr; @L["quests.backToList"]</a>

    <div class="frame mt-3 p-6">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h1 class="page-title break-words text-2xl">@Model.Quest.Title</h1>
                <p class="mt-2 text-sm text-dust">
                    <a asp-controller="Locations" asp-action="Details" asp-route-id="@Model.Quest.LocationId"
                       class="link">@Model.LocationName</a>
                    <span class="text-dust/70">|</span> @Model.LocationRegion
                </p>
            </div>
            <span class="badge">Lv. @Model.Quest.Level</span>
        </div>

        <p class="mt-5 whitespace-pre-line leading-relaxed text-parchment/90">@L.Content("quests", Model.Quest.Title, Model.Quest.Description)</p>

        @{
            var questImage = Images.Quest(Model.Quest.Title, Model.Quest.ImagePath, large: true);
        }
        @if (questImage is not null)
        {
            <img src="@questImage" alt="@Model.Quest.Title" width="1600" height="900"
                 class="mt-5 h-auto w-full rounded-sm border border-slate object-cover" />
        }

        <dl class="mt-6 grid grid-cols-1 gap-4 border-t border-gold/15 pt-5 sm:grid-cols-2">
            <div>
                <dt class="meta">
                    @L["quests.reward"]</dt>
                <dd class="mt-1 text-parchment">@Model.Quest.Reward</dd>
            </div>
            <div>
                <dt class="meta">
                    @L["quests.added"]</dt>
                <dd class="mt-1 text-parchment">@Model.Quest.CreatedAt.ToString("dd MMM yyyy")</dd>
            </div>
        </dl>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="mt-6 flex flex-wrap gap-3 border-t border-gold/15 pt-5">
                <a asp-action="Edit" asp-route-id="@Model.Quest.Id" class="btn btn-ghost">
                    @L["quests.edit"]</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Delete" asp-route-id="@Model.Quest.Id" class="btn btn-danger">
                        @L["quests.delete"]</a>
                }
            </div>
        }
    </div>

    @Html.AntiForgeryToken()
    <div id="quest-comments"
         data-quest-id="@Model.Quest.Id"
         data-lang="@L.Lang"
         data-auth="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
    </div>
</article>
