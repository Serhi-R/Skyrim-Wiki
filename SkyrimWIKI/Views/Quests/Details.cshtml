@model SkyrimWIKI.Models.ViewModels.QuestDetailsViewModel
@{
    ViewData["Title"] = Model.Quest.Title;
}

<article class="mx-auto max-w-3xl">
    <a asp-action="Index" class="text-sm font-medium text-emerald-700 hover:underline">
        &larr; <span class="t-en">All quests</span><span class="t-bg">Всички задания</span>
    </a>

    <div class="mt-3 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">@Model.Quest.Title</h1>
                <p class="mt-1 text-sm text-slate-500">
                    <a asp-controller="Locations" asp-action="Details" asp-route-id="@Model.Quest.LocationId"
                       class="hover:text-emerald-700 hover:underline">@Model.LocationName</a>
                    &middot; @Model.LocationRegion
                </p>
            </div>
            <span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700">
                Lv. @Model.Quest.Level
            </span>
        </div>

        <p class="mt-5 whitespace-pre-line leading-relaxed text-slate-700">@Model.Quest.Description</p>

        @if (Model.Quest.ImagePath is not null)
        {
            <img src="@Model.Quest.ImagePath" alt="@Model.Quest.Title"
                 class="mt-5 w-full rounded-lg border border-slate-200 object-cover" />
        }

        <dl class="mt-6 grid grid-cols-1 gap-4 border-t border-slate-100 pt-5 sm:grid-cols-2">
            <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">
                    <span class="t-en">Reward</span><span class="t-bg">Награда</span>
                </dt>
                <dd class="mt-1 text-sm text-slate-700">@Model.Quest.Reward</dd>
            </div>
            <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">
                    <span class="t-en">Added</span><span class="t-bg">Добавено</span>
                </dt>
                <dd class="mt-1 text-sm text-slate-700">@Model.Quest.CreatedAt.ToString("dd MMM yyyy")</dd>
            </div>
        </dl>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="mt-6 flex gap-3 border-t border-slate-100 pt-5">
                <a asp-action="Edit" asp-route-id="@Model.Quest.Id"
                   class="rounded-md bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200">
                    <span class="t-en">Edit</span><span class="t-bg">Редакция</span>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Quest.Id"
                   class="rounded-md bg-rose-50 px-4 py-2 text-sm font-medium text-rose-700 hover:bg-rose-100">
                    <span class="t-en">Delete</span><span class="t-bg">Изтриване</span>
                </a>
            </div>
        }
    </div>

    <section class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-slate-900">
                <span class="t-en">Comments</span><span class="t-bg">Коментари</span>
            </h2>
            <div class="flex items-center gap-2">
                <partial name="_Stars" model="Model.AverageRating" />
                <span class="text-sm text-slate-500">
                    @Model.AverageRating.ToString("0.0") / 5 (@Model.Comments.Count)
                </span>
            </div>
        </div>

        @if (Model.Comments.Count == 0)
        {
            <p class="mt-4 rounded-lg border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500">
                <span class="t-en">No comments yet. Be the first.</span>
                <span class="t-bg">Още няма коментари. Бъди първи.</span>
            </p>
        }
        else
        {
            <ul class="mt-4 space-y-4">
                @foreach (var comment in Model.Comments)
                {
                    <li class="rounded-lg bg-slate-50 p-4">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <p class="text-sm font-semibold text-slate-800">@comment.AuthorName</p>
                            <partial name="_Stars" model="(double)comment.Rating" />
                        </div>
                        <p class="mt-1 text-xs text-slate-400">@comment.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                        <p class="mt-2 whitespace-pre-line text-sm text-slate-700">@comment.Text</p>
                    </li>
                }
            </ul>
        }

        @if (User.Identity?.IsAuthenticated != true)
        {
            <p class="mt-4 text-sm text-slate-500">
                <a asp-area="Identity" asp-page="/Account/Login" class="font-medium text-emerald-700 hover:underline">
                    <span class="t-en">Sign in</span><span class="t-bg">Влез</span>
                </a>
                <span class="t-en">to leave a rating and a comment.</span>
                <span class="t-bg">за да оставиш оценка и коментар.</span>
            </p>
        }
    </section>
</article>
