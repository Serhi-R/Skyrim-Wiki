@using Microsoft.AspNetCore.Mvc.Rendering
@model Quest

<div class="space-y-4">
    <div>
        <label asp-for="Title" class="label">
            @L["form.title"]</label>
        <input asp-for="Title" class="input" />
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label asp-for="Description" class="label">
            @L["form.description"]</label>
        <textarea asp-for="Description" rows="5" class="input"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
            <label asp-for="Level" class="label">
                @L["form.level"]</label>
            <input asp-for="Level" type="number" min="1" max="81" class="input" />
            <span asp-validation-for="Level"></span>
        </div>

        <div>
            <label asp-for="LocationId" class="label">
                @L["form.location"]</label>
            <select asp-for="LocationId" asp-items="@(ViewData["Locations"] as SelectList)" class="input"></select>
            <span asp-validation-for="LocationId"></span>
        </div>
    </div>

    <div>
        <label asp-for="Reward" class="label">
            @L["form.reward"]</label>
        <input asp-for="Reward" class="input" />
        <span asp-validation-for="Reward"></span>
    </div>

    <div>
        <label asp-for="Image" class="label">
            @L["form.image"]</label>
        <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp" class="input" />
        <p class="mt-1 text-xs text-dust">
            @L["form.imageHint"]
        </p>
        <span asp-validation-for="Image"></span>
    </div>
</div>
