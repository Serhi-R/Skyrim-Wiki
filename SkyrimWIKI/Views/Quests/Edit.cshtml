@model SkyrimWIKI.Models.ViewModels.QuestFormViewModel
@{
    ViewData["Title"] = L["quests.editTitle"];
}

<div class="mx-auto max-w-xl">
    <h1 class="page-title text-2xl">
        @L["quests.editTitle"]</h1>
    <hr class="divider-gold mt-3 w-full" />

    <form asp-action="Edit" asp-route-id="@Model.Quest.Id" method="post" enctype="multipart/form-data" class="frame mt-5 p-6">
        <div asp-validation-summary="ModelOnly" class="note-error mb-4"></div>
        <input type="hidden" asp-for="Quest.Id" />

        @if (Model.Quest.ImagePath is not null)
        {
            <div class="mb-4">
                <p class="label">
                    @L["quests.currentImage"]</p>
                <img src="@Model.Quest.ImagePath" alt="@Model.Quest.Title"
                     class="h-32 w-auto rounded-sm border border-gold/25 object-cover" />
            </div>
        }

        <partial name="_QuestForm" model="Model.Quest" view-data='@(new ViewDataDictionary(ViewData) { ["Locations"] = Model.Locations })' />

        <div class="mt-6 flex gap-3">
            <button type="submit" class="btn btn-solid">
                @L["quests.saveChanges"]</button>
            <a asp-action="Details" asp-route-id="@Model.Quest.Id" class="btn btn-ghost">
                @L["quests.cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
