@model SkyrimWIKI.Models.ViewModels.QuestIndexViewModel
@{
    ViewData["Title"] = "Quests";
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900">
        <span class="t-en">Quests</span><span class="t-bg">Задания</span>
    </h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create"
           class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
            <span class="t-en">New quest</span><span class="t-bg">Ново задание</span>
        </a>
    }
</div>

<form asp-action="Index" method="get"
      class="mt-5 grid grid-cols-1 gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-6">
    <div class="lg:col-span-2">
        <label for="Term" class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">
            <span class="t-en">Search</span><span class="t-bg">Търсене</span>
        </label>
        <input id="Term" name="Term" value="@Model.Filter.Term" placeholder="Barrow..."
               class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
    </div>

    <div>
        <label for="LocationId" class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">
            <span class="t-en">Location</span><span class="t-bg">Локация</span>
        </label>
        <select id="LocationId" name="LocationId"
                class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
            <option value="">All / Всички</option>
            @foreach (var location in Model.Locations)
            {
                <option value="@location.Id" selected="@(Model.Filter.LocationId == location.Id)">@location.Name</option>
            }
        </select>
    </div>

    <div>
        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">
            <span class="t-en">Level</span><span class="t-bg">Ниво</span>
        </label>
        <div class="flex items-center gap-2">
            <input name="MinLevel" type="number" min="1" max="81" value="@Model.Filter.MinLevel" placeholder="1"
                   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
            <span class="text-slate-400">-</span>
            <input name="MaxLevel" type="number" min="1" max="81" value="@Model.Filter.MaxLevel" placeholder="81"
                   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
        </div>
    </div>

    <div>
        <label for="Sort" class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">
            <span class="t-en">Sort by</span><span class="t-bg">Сортиране</span>
        </label>
        <select id="Sort" name="Sort"
                class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
            <option value="title" selected="@(Model.Filter.Sort is null or "title")">Title / Заглавие</option>
            <option value="level" selected="@(Model.Filter.Sort == "level")">Level, low to high / Ниво, възходящо</option>
            <option value="level_desc" selected="@(Model.Filter.Sort == "level_desc")">Level, high to low / Ниво, низходящо</option>
            <option value="newest" selected="@(Model.Filter.Sort == "newest")">Newest first / Най-нови първо</option>
            <option value="oldest" selected="@(Model.Filter.Sort == "oldest")">Oldest first / Най-стари първо</option>
            <option value="location" selected="@(Model.Filter.Sort == "location")">Location / Локация</option>
        </select>
    </div>

    <div class="flex items-end gap-2">
        <button type="submit"
                class="w-full rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">
            <span class="t-en">Filter</span><span class="t-bg">Филтрирай</span>
        </button>
        <a asp-action="Index"
           class="rounded-md bg-slate-100 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200">
            <span class="t-en">Reset</span><span class="t-bg">Изчисти</span>
        </a>
    </div>
</form>

<p class="mt-4 text-sm text-slate-500">
    @Model.TotalCount
    <span class="t-en">quests found</span><span class="t-bg">намерени задания</span>
</p>

@if (Model.Quests.Count == 0)
{
    <p class="mt-6 rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500">
        <span class="t-en">Nothing matches this filter.</span>
        <span class="t-bg">Няма задания по този филтър.</span>
    </p>
}
else
{
    <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var quest in Model.Quests)
        {
            <partial name="_QuestCard" model="quest" />
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-6 flex items-center justify-center gap-2">
            @if (Model.HasPreviousPage)
            {
                <a asp-action="Index" asp-route-Term="@Model.Filter.Term" asp-route-LocationId="@Model.Filter.LocationId"
                   asp-route-MinLevel="@Model.Filter.MinLevel" asp-route-MaxLevel="@Model.Filter.MaxLevel"
                   asp-route-Sort="@Model.Filter.Sort" asp-route-Page="@(Model.Filter.Page - 1)"
                   class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">
                    &larr; <span class="t-en">Previous</span><span class="t-bg">Предишна</span>
                </a>
            }
            <span class="px-3 text-sm text-slate-500">
                <span class="t-en">Page</span><span class="t-bg">Страница</span>
                @Model.Filter.Page / @Model.TotalPages
            </span>
            @if (Model.HasNextPage)
            {
                <a asp-action="Index" asp-route-Term="@Model.Filter.Term" asp-route-LocationId="@Model.Filter.LocationId"
                   asp-route-MinLevel="@Model.Filter.MinLevel" asp-route-MaxLevel="@Model.Filter.MaxLevel"
                   asp-route-Sort="@Model.Filter.Sort" asp-route-Page="@(Model.Filter.Page + 1)"
                   class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">
                    <span class="t-en">Next</span><span class="t-bg">Следваща</span> &rarr;
                </a>
            }
        </nav>
    }
}
