@{
    ViewData["Title"] = L["quests.title"];
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="page-title text-2xl">
        @L["quests.title"]</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-solid btn-sm">
            @L["quests.new"]</a>
    }
</div>
<hr class="divider-gold mt-3 w-full" />

<div id="quest-catalog" class="mt-5" data-lang="@L.Lang">
    <p class="empty">
        @L["quests.loading"]
    </p>
</div>
