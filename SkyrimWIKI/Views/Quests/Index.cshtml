@{
    ViewData["Title"] = "Quests";
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900">
        <span class="t-en">Quests</span><span class="t-bg">Задания</span>
    </h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create"
           class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
            <span class="t-en">New quest</span><span class="t-bg">Ново задание</span>
        </a>
    }
</div>

<div id="quest-catalog" class="mt-5">
    <p class="rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500">
        <span class="t-en">Loading the quest catalog...</span>
        <span class="t-bg">Зареждане на каталога...</span>
    </p>
</div>
