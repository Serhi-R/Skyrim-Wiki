@model SkyrimWIKI.Models.ViewModels.QuestFormViewModel
@{
    ViewData["Title"] = L["quests.new"];
}

<div class="mx-auto max-w-xl">
    <h1 class="page-title text-2xl">
        @L["quests.new"]</h1>
    <hr class="divider-gold mt-3 w-full" />

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="frame mt-5 p-6">
        <div asp-validation-summary="ModelOnly" class="note-error mb-4"></div>

        <partial name="_QuestForm" model="Model.Quest" view-data='@(new ViewDataDictionary(ViewData) { ["Locations"] = Model.Locations })' />

        <div class="mt-6 flex gap-3">
            <button type="submit" class="btn btn-solid">
                @L["quests.save"]</button>
            <a asp-action="Index" class="btn btn-ghost">
                @L["quests.cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
