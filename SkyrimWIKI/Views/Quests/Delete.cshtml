@model Quest
@{
    ViewData["Title"] = L["quests.deleteTitle"];
}

<div class="frame mx-auto max-w-xl p-6">
    <h1 class="page-title text-2xl">
        @L["quests.deleteTitle"]</h1>
    <p class="mt-2 text-sm text-parchment/85">
        @L["quests.deleteConfirm"]
    </p>

    <div class="mt-4 rounded-sm border border-gold/15 bg-black/25 p-4">
        <p class="font-display font-semibold text-ivory">@Model.Title</p>
        <p class="mt-1 text-sm text-dust">Lv. @Model.Level</p>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-6 flex gap-3">
        <button type="submit" class="btn btn-danger">
            @L["quests.delete"]</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">
            @L["quests.cancel"]</a>
    </form>
</div>
