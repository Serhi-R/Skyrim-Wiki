@using Microsoft.AspNetCore.Identity
@using SkyrimWIKI.Models
@inject SignInManager<ApplicationUser> SignInManager

<ul class="flex items-center gap-3 text-sm">
@if (SignInManager.IsSignedIn(User))
    {
        <li class="text-parchment">@User.Identity?.Name</li>
        <li>
            <form asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn btn-ghost btn-sm">@L["nav.logout"]</button>
            </form>
        </li>
    }
    else
    {
        <li>
            <a asp-area="Identity" asp-page="/Account/Register" class="link">@L["nav.register"]</a>
        </li>
        <li>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-solid btn-sm">@L["nav.login"]</a>
        </li>
    }
</ul>
