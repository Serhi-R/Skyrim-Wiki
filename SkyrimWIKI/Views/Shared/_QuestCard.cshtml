@model SkyrimWIKI.Models.ViewModels.QuestCardViewModel

<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
    <div class="flex items-start justify-between gap-2">
        <h3 class="font-semibold text-slate-900">@Model.Title</h3>
        <span class="shrink-0 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
            Lv. @Model.Level
        </span>
    </div>
    <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-400">@Model.LocationName</p>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">@Model.Excerpt</p>
</div>
