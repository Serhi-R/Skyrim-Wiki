@model SkyrimWIKI.Models.ViewModels.QuestCardViewModel
@{
    var image = Images.Quest(Model.Title, Model.ImagePath);
    var excerpt = L.Content("quests", Model.Title, Model.Excerpt);
    if (excerpt.Length > 140)
    {
        excerpt = excerpt[..140] + "...";
    }
}

<div class="frame frame-hover h-full overflow-hidden">
    @if (image is not null)
    {
        <div class="relative h-32 border-b border-slate">
            <img src="@image" alt="@Model.Title" width="800" height="533"
                 loading="lazy" class="cover" />
        </div>
    }
    <div class="p-5">
        <div class="flex items-start justify-between gap-2">
            <h3 class="break-words font-display text-base font-semibold text-ivory">
                <a asp-controller="Quests" asp-action="Details" asp-route-id="@Model.Id"
                   class="hover:text-candle">@Model.Title</a>
            </h3>
            <span class="badge shrink-0">Lv. @Model.Level</span>
        </div>
        <p class="meta mt-2">@Model.LocationName</p>
        <p class="mt-2 text-sm leading-relaxed text-frost/80">@excerpt</p>
    </div>
</div>
