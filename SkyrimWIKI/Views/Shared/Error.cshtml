@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="mx-auto max-w-lg rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
    <p class="text-5xl font-bold text-rose-600">500</p>
    <h1 class="mt-3 text-xl font-bold text-slate-900">
        <span class="t-en">Something went wrong</span><span class="t-bg">Нещо се обърка</span>
    </h1>
    <p class="mt-2 text-sm text-slate-600">
        <span class="t-en">The request could not be completed. Please try again.</span>
        <span class="t-bg">Заявката не можа да бъде изпълнена. Опитайте отново.</span>
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-xs text-slate-400">
            <span class="t-en">Request ID</span><span class="t-bg">Идентификатор</span>:
            <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index"
       class="mt-6 inline-block rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
        <span class="t-en">Back to home</span><span class="t-bg">Към началото</span>
    </a>
</div>
