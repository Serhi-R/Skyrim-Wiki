@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="frame mx-auto max-w-lg p-8 text-center">
    <p class="font-display text-5xl font-bold text-ember-text">500</p>
    <h1 class="page-title mt-3 text-xl">
        Something went wrong</h1>
    <p class="mt-2 text-sm text-parchment/85">
        The request could not be completed. Please try again.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-xs text-dust">
            Request ID:
            <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-solid mt-6">
        Back to home</a>
</div>
