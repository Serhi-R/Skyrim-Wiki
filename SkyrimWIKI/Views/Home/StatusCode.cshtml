@model int
@{
    ViewData["Title"] = $"Status {Model}";
    var (headingEn, headingBg) = Model switch
    {
        404 => ("Page not found", "Страницата не е намерена"),
        403 => ("Access denied", "Достъпът е отказан"),
        400 => ("Bad request", "Невалидна заявка"),
        _ => ("Unexpected status", "Неочакван статус")
    };
}

<div class="mx-auto max-w-lg rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
    <p class="text-5xl font-bold text-slate-300">@Model</p>
    <h1 class="mt-3 text-xl font-bold text-slate-900">
        <span class="t-en">@headingEn</span><span class="t-bg">@headingBg</span>
    </h1>
    <p class="mt-2 text-sm text-slate-600">
        <span class="t-en">The page you asked for does not exist or moved.</span>
        <span class="t-bg">Търсената страница не съществува или е преместена.</span>
    </p>
    <a asp-controller="Quests" asp-action="Index"
       class="mt-6 inline-block rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
        <span class="t-en">Browse quests</span><span class="t-bg">Разгледай заданията</span>
    </a>
</div>
