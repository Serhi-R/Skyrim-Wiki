@model SkyrimWIKI.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = L["nav.home"];
}

<section class="relative overflow-hidden rounded-sm border border-slate">
    <img src="@Images.Hero()" alt="" width="1600" height="1067"
         class="cover" fetchpriority="high" />
    <div class="absolute inset-0"
         style="background: linear-gradient(180deg, rgba(11,14,18,0.3) 0%, rgba(15,19,24,0.72) 55%, rgba(15,19,24,0.96) 100%);"></div>
    <div class="relative px-6 py-16 text-center sm:px-10 sm:py-24">
        <img src="~/img/logo.svg" alt="" width="48" height="48" class="mx-auto h-12 w-12" />
        <h1 class="page-title mt-4 text-4xl sm:text-5xl">SkyrimWIKI</h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-frost/90">
            @L["home.tagline"]
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
            <a asp-controller="Quests" asp-action="Index" class="btn btn-solid">@L["home.browseQuests"]</a>
            <a asp-controller="Locations" asp-action="Index" class="btn btn-ghost">@L["home.exploreHolds"]</a>
        </div>
    </div>
</section>

<dl class="mt-8 grid grid-cols-3 divide-x divide-slate border-y border-slate">
    <div class="px-4 py-5 text-center">
        <dt class="meta">@L["home.statQuests"]</dt>
        <dd class="stat-num mt-1 text-3xl">@Model.QuestCount</dd>
    </div>
    <div class="px-4 py-5 text-center">
        <dt class="meta">@L["home.statLocations"]</dt>
        <dd class="stat-num mt-1 text-3xl">@Model.LocationCount</dd>
    </div>
    <div class="px-4 py-5 text-center">
        <dt class="meta">@L["home.statRaces"]</dt>
        <dd class="stat-num mt-1 text-3xl">@Model.RaceCount</dd>
    </div>
</dl>

<section class="mt-10">
    <h2 class="section-title text-lg">@L["home.latestQuests"]</h2>
    <hr class="divider-gold mt-3 w-full" />
    <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var quest in Model.LatestQuests)
        {
            <partial name="_QuestCard" model="quest" />
        }
    </div>
</section>
