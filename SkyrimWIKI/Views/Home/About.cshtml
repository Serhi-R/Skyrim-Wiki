@{
    ViewData["Title"] = L["nav.about"];
}

<h1 class="page-title text-2xl">@L["about.title"]</h1>
<hr class="divider-gold mt-3 w-full" />

<section class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div class="frame p-5">
        <h2 class="section-title text-base">@L["about.team"]</h2>
        <p class="mt-3 text-frost">Сергий Рашков</p>
        <p class="mt-1 text-sm text-ice">Serhii Rashkov</p>
        <p class="mt-1 text-sm text-ice">Факултетен №: 158ИКР / 158IKR</p>
        <p class="mt-1 text-sm text-ice">ITIKS / ИТИКС</p>
        <p class="mt-1 text-sm text-ice">@L["about.teamNote"]</p>
    </div>

    <div class="frame p-5">
        <h2 class="section-title text-base">@L["about.features"]</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-frost/90">
            <li>@L["about.features.1"]</li>
            <li>@L["about.features.2"]</li>
            <li>@L["about.features.3"]</li>
            <li>@L["about.features.4"]</li>
            <li>@L["about.features.5"]</li>
            <li>@L["about.features.6"]</li>
            <li>@L["about.features.7"]</li>
        </ul>
    </div>

    <div class="frame p-5">
        <h2 class="section-title text-base">@L["about.tech"]</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-frost/90">
            <li>@L["about.tech.1"]</li>
            <li>@L["about.tech.2"]</li>
            <li>@L["about.tech.3"]</li>
            <li>@L["about.tech.4"]</li>
            <li>@L["about.tech.5"]</li>
            <li>@L["about.tech.6"]</li>
        </ul>
    </div>
</section>

<section class="frame mt-6 p-6">
    <h2 class="section-title text-base">@L["about.arch"]</h2>
    <p class="mt-3 leading-relaxed text-frost/90">
        @L["about.archText"]
    </p>
</section>
