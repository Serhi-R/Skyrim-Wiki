{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "DataSource=app.db;Cache=Shared",
    "PostgreSql": "Host=localhost;Port=5432;Database=skyrimwiki;Username=<name>;Password=<password>"
  },
  "Identity": {
    "Admin": {
      "Email": "admin@skyrimwiki.local",
      "Password": "Admin123!"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
