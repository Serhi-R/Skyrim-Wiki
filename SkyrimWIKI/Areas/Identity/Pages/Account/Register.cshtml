@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="mx-auto max-w-md">
    <div class="frame p-6">
        <h1 class="page-title text-2xl">Register</h1>
        <p class="mt-2 text-sm text-dust">Create an account to comment on quests.</p>
        <hr class="divider-gold mt-4 w-full" />

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="note-error" role="alert"></div>

            <div>
                <label asp-for="Input.Email" class="label">Email</label>
                <input asp-for="Input.Email" autocomplete="username" aria-required="true"
                       placeholder="name@example.com" class="input" />
                <span asp-validation-for="Input.Email"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="label">Password</label>
                <div class="relative">
                    <input asp-for="Input.Password" type="password" autocomplete="new-password"
                           aria-required="true" placeholder="password" class="input pr-24" />
                    <button type="button" data-toggle-password="#Input_Password" aria-pressed="false"
                            class="absolute inset-y-0 right-2 my-auto h-7 rounded-sm border border-gold/30 px-2 text-xs font-semibold text-dust hover:border-gold/60 hover:text-gold">
                        Show
                    </button>
                </div>
                <p class="mt-1 text-xs text-dust">At least 8 characters, with upper and lower case letters and a digit.</p>
                <span asp-validation-for="Input.Password"></span>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="label">Confirm password</label>
                <div class="relative">
                    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password"
                           aria-required="true" placeholder="password" class="input pr-24" />
                    <button type="button" data-toggle-password="#Input_ConfirmPassword" aria-pressed="false"
                            class="absolute inset-y-0 right-2 my-auto h-7 rounded-sm border border-gold/30 px-2 text-xs font-semibold text-dust hover:border-gold/60 hover:text-gold">
                        Show
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-solid btn-block">Register</button>

            <p class="text-sm text-dust">
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="link">
                    Already have an account? Log in
                </a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
