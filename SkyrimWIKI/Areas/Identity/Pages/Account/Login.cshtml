@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="mx-auto max-w-md">
    <div class="frame p-6">
        <h1 class="page-title text-2xl">Log in</h1>
        <p class="mt-2 text-sm text-dust">Sign in with your email and password.</p>
        <hr class="divider-gold mt-4 w-full" />

        <form id="account" method="post" class="mt-5 space-y-4">
            <div asp-validation-summary="ModelOnly" class="note-error" role="alert"></div>

            <div>
                <label asp-for="Input.Email" class="label">Email</label>
                <input asp-for="Input.Email" autocomplete="username" aria-required="true"
                       placeholder="name@example.com" class="input" />
                <span asp-validation-for="Input.Email"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="label">Password</label>
                <div class="relative">
                    <input asp-for="Input.Password" type="password" autocomplete="current-password"
                           aria-required="true" placeholder="password" class="input pr-24" />
                    <button type="button" data-toggle-password="#Input_Password" aria-pressed="false"
                            class="absolute inset-y-0 right-2 my-auto h-7 rounded-sm border border-gold/30 px-2 text-xs font-semibold text-dust hover:border-gold/60 hover:text-gold">
                        Show
                    </button>
                </div>
                <span asp-validation-for="Input.Password"></span>
            </div>

            <div class="flex items-center gap-2">
                <input asp-for="Input.RememberMe" class="h-4 w-4" />
                <label asp-for="Input.RememberMe" class="text-sm text-parchment">Remember me</label>
            </div>

            <button id="login-submit" type="submit" class="btn btn-solid btn-block">Log in</button>

            <p class="text-sm text-dust">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="link">
                    Register as a new user
                </a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
